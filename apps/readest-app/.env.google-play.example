# Copy to .env.google-play.local (gitignored) and fill in the values.
# Sourced by scripts/release-google-play.sh.

# --- Play Console upload identity ---
export PACKAGE_NAME="com.bookarc.app"
# Google Play service-account JSON with Play Developer API access (used by
# fastlane to upload). Create it in Google Cloud, grant access in Play Console.
export GOOGLE_PLAY_JSON_KEY_FILE="/absolute/path/to/play-service-account.json"

# --- Android upload keystore ---
# Generate once with keytool (see the release docs). Use the SAME value for the
# keystore and key password; Tauri's signingConfig reads a single `password`.
export ANDROID_KEY_ALIAS="bookarc-upload"
export ANDROID_KEY_PASSWORD="your-keystore-password"
export ANDROID_KEYSTORE_FILE="$HOME/keys/bookarc-upload.jks"
