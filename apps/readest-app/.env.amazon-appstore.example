# Copy to .env.amazon-appstore.local (gitignored). Never commit credentials.
# Android SDK and the SAME upload keystore used for existing Android releases.
ANDROID_HOME=/absolute/path/to/Android/sdk
ANDROID_KEY_ALIAS=bookarc-upload
ANDROID_KEY_PASSWORD=your-keystore-password
ANDROID_KEYSTORE_FILE=/absolute/path/to/bookarc-upload.jks

# Only needed for updates AFTER the first release is published via the console.
# Create an App Submission API security profile in the Amazon Developer Console.
AMAZON_APP_ID=com.bookarc.app
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

# Optional: larger than the currently published Amazon versionCode.
# Otherwise Tauri derives the version code from package.json as usual.
# AMAZON_VERSION_CODE=12007
